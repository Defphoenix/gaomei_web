GAOMEI_WEB_DEBUG=false
GAOMEI_WEB_SECRET_KEY=replace-with-a-long-random-value
GAOMEI_WEB_ALLOWED_HOSTS=gomics.icu,www.gomics.icu,118.25.149.190,localhost,127.0.0.1
GAOMEI_WEB_CORS_ORIGINS=https://gomics.icu,https://www.gomics.icu,http://gomics.icu,http://www.gomics.icu,http://118.25.149.190
GAOMEI_WEB_CSRF_TRUSTED_ORIGINS=https://gomics.icu,https://www.gomics.icu,http://gomics.icu,http://www.gomics.icu,http://118.25.149.190
GAOMEI_WEB_TIME_ZONE=Asia/Shanghai
GAOMEI_WEB_SECURE_COOKIES=false
GAOMEI_WEB_STATIC_ROOT=/var/lib/gaomei_web/static
GAOMEI_WEB_MEDIA_ROOT=/var/lib/gaomei_web/media
# Formal WES report packages (JSON/assets) and generated HTML/PDF.
# Linux PDF 与 HTML 预览对齐：优先 Chrome headless（安装 google-chrome-stable）。
# 可选：WES_REPORT_BROWSER=/usr/bin/google-chrome-stable
# 强制走 WeasyPrint（不推荐）：WES_REPORT_FORCE_WEASYPRINT=1
GAOMEI_WES_BUNDLE_ROOT=/var/lib/gaomei_web/media/wes_bundles
GAOMEI_WES_REPORT_DATA_DIR=/var/lib/gaomei_web/media/wes_reports
GAOMEI_WES_REPORT_OUTPUT_DIR=/var/lib/gaomei_web/media/wes_output
# Store only SHA256(token text without trailing CR/LF); never store the raw node token here.
